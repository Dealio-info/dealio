# Copy to `.env` and fill in. `.env` is gitignored and must stay that way —
# the prototype repo committed its own and we are not repeating that.

# Postgres (Supabase gives you both). Prisma needs the pooled URL at runtime
# and the direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Integration tests. Must point at a throwaway database and must NOT equal
# DATABASE_URL — the harness truncates every table between tests and refuses to
# run if the two match. The suite creates the database if it does not exist.
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/dealio_test"

# Supabase Auth. Use the newer `sb_publishable_…` / `sb_secret_…` keys — the
# legacy `anon` and `service_role` JWTs are deprecated.
#
# The publishable key is safe in the browser, which is why it carries the
# NEXT_PUBLIC_ prefix. The secret key bypasses every authorization check in
# Supabase and must NEVER be prefixed NEXT_PUBLIC_ — that would ship it to
# every visitor.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Transactional email via Resend. Server-only — never prefix NEXT_PUBLIC_.
#
# Without a key, development prints each email to the server console instead
# of sending it, and production refuses to send and records the reason in
# `email_sends` — so a missing key is visible rather than silent.
RESEND_API_KEY=""
# Only the address is used; the display name becomes "<Business> via Dealio".
# Must be on a domain verified in Resend. Until one is, use Resend's shared
# test sender, which delivers only to the Resend account owner's own address:
#   EMAIL_FROM="Dealio <onboarding@resend.dev>"
EMAIL_FROM="Dealio <noreply@dealio.info>"

# Public origin, used to build every link that leaves the app — invite links,
# email buttons, unsubscribe links — and the sign-out redirect. No trailing
# slash needed; one is stripped if present. Production must set this — the
# fallback is http://localhost:3000, which is right on your machine and broken
# in anyone else's inbox. NEXT_PUBLIC_ values are baked in at build time, so
# redeploy after changing it.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: NEXT_PUBLIC_APP_URL="https://dealio.info"

# ---------------------------------------------------------------------------
# The Vercel Supabase integration, if installed, adds its own variables:
# POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, POSTGRES_USER,
# POSTGRES_HOST, POSTGRES_PASSWORD, POSTGRES_DATABASE, SUPABASE_URL,
# SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWT_SECRET.
#
# The app reads NONE of them. It reads only the names in this file. The
# integration's set does not cover what the app needs — it has no
# NEXT_PUBLIC_ Supabase URL, and its keys are the legacy anon/service_role
# JWTs this app deliberately does not use — so its variables would be a
# second, partial copy of the same settings. See docs/decisions.md.
# ---------------------------------------------------------------------------
