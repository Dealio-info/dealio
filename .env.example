# Copy to `.env` and fill in. `.env` is gitignored and must stay that way —
# the prototype repo committed its own and we are not repeating that.

# Postgres (Supabase gives you both). Prisma needs the pooled URL at runtime
# and the direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Integration tests. Must point at a throwaway database and must NOT equal
# DATABASE_URL — the harness truncates every table between tests and refuses to
# run if the two match. The suite creates the database if it does not exist.
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/dealio_test"

# Supabase Auth. Use the newer `sb_publishable_…` / `sb_secret_…` keys — the
# legacy `anon` and `service_role` JWTs are deprecated.
#
# The publishable key is safe in the browser, which is why it carries the
# NEXT_PUBLIC_ prefix. The secret key bypasses every authorization check in
# Supabase and must NEVER be prefixed NEXT_PUBLIC_ — that would ship it to
# every visitor.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Transactional email (Task 14).
RESEND_API_KEY=""
EMAIL_FROM="Dealio <noreply@dealio.info>"

# Public origin, used for building invite and magic links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
