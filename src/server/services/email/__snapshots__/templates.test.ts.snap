exports[`renderEmail > renders ADVOCATE_INVITE > html 1`] = `
"<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Acme invited you to be an advocate</title></head>
<body style="margin:0;padding:0;background:#f8fafc;font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc">
<tr><td align="center" style="padding:32px 16px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #d8dfe9;border-radius:8px;border-collapse:separate">
<tr><td style="height:4px;line-height:4px;font-size:0;border-radius:8px 8px 0 0;background-color:#81d147;background-image:linear-gradient(90deg,#81d147,#39aca3)">&nbsp;</td></tr>
<tr><td style="padding:32px">
<p style="margin:0 0 24px;color:#111c2c;font-size:18px;font-weight:700;letter-spacing:-0.01em">Dealio</p>
<h1 style="margin:0 0 24px;color:#111c2c;font-size:22px;line-height:1.3">Acme invited you to be an advocate</h1>
<p style="margin:0 0 16px;color:#111c2c;font-size:16px;line-height:1.5">Hi Dana,</p>
<p style="margin:0 0 16px;color:#111c2c;font-size:16px;line-height:1.5">Acme would like you to be one of their advocates. You will see the quests they ask of you — a referral, a reference call, a testimonial — earn coins for the ones you complete, and spend them on rewards they offer.</p>
<p style="margin:24px 0"><a href="https://dealio.info/invite/abc123" style="display:inline-block;padding:12px 22px;border-radius:8px;background:#81d147;color:#111c2c;font-size:15px;font-weight:600;text-decoration:none">Accept invitation</a></p>
<p style="margin:0 0 16px;color:#49596e;font-size:14px;line-height:1.5">This link works once and expires on Sun, 29 Nov 2026. If you were not expecting it, you can ignore this email.</p>
</td></tr>
</table>
<p style="max-width:560px;margin:16px auto 0;color:#49596e;font-size:12px;line-height:1.5">You are getting this because Acme invited you to be an advocate on Dealio. <a href="https://dealio.info/unsubscribe/7c1b3e2a-0000-4000-8000-000000000000" style="color:#49596e">Unsubscribe from Acme emails</a>.</p>
</td></tr>
</table>
</body>
</html>
"
`;

exports[`renderEmail > renders ADVOCATE_INVITE > subject 1`] = `"Acme invited you to be an advocate"`;

